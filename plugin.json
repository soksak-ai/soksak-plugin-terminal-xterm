{
  "id": "soksak-plugin-terminal-xterm",
  "name": {
    "en": "Terminal",
    "ko": "터미널"
  },
  "version": "0.0.18",
  "appVersionRequirement": "0.0.1",
  "description": {
    "en": "A terminal view backed by a real login shell. xterm.js renders; the host's PTY commands run the shell.",
    "ko": "실제 로그인 셸에 붙는 터미널 뷰. 렌더링은 xterm.js, 셸은 호스트의 PTY 명령."
  },
  "entry": "main.js",
  "permissions": [
    "ui",
    "ui:statusbar",
    "commands",
    "programs",
    "sidecar",
    "secrets",
    "terminal"
  ],
  "implements": [
    { "id": "soksak-spec-plugin-terminal", "version": "0.0.3" }
  ],
  "contributes": {
    "commands": [
      {
        "name": "status",
        "title": { "en": "Terminal status", "ko": "터미널 상태" }
      },
      {
        "name": "wait",
        "title": { "en": "Wait for terminal phase", "ko": "터미널 단계 대기" }
      },
      { "name": "archive", "title": { "en": "Archive terminal state", "ko": "터미널 상태 보관" } },
      {
        "name": "focus",
        "title": { "en": "Focus terminal", "ko": "터미널 포커스" }
      },
      {
        "name": "recovery-status",
        "title": { "en": "Terminal recovery status", "ko": "터미널 복원 상태" }
      },
      {
        "name": "clear",
        "title": {
          "en": "Clear terminal",
          "ko": "터미널 지우기"
        }
      },
      {
        "name": "send",
        "title": {
          "en": "Send input",
          "ko": "입력 보내기"
        },
        "danger": "inject"
      },
      {
        "name": "read",
        "title": {
          "en": "Read the screen",
          "ko": "화면 읽기"
        }
      },
      {
        "name": "exec",
        "title": {
          "en": "Run a command",
          "ko": "명령 실행"
        },
        "danger": "inject"
      },
      {
        "name": "cwd",
        "title": {
          "en": "Working directory",
          "ko": "작업 디렉터리"
        }
      },
      {
        "name": "benchmark.parser",
        "title": {
          "en": "Measure renderer parser",
          "ko": "렌더러 파서 측정"
        }
      }
    ],
    "nodes": [
      {
        "id": "terminal-root",
        "description": { "en": "The terminal root", "ko": "터미널 루트" }
      },
      {
        "id": "terminal-screen",
        "description": {
          "en": "The terminal screen",
          "ko": "터미널 화면"
        }
      },
      {
        "id": "terminal-input",
        "description": { "en": "The terminal input", "ko": "터미널 입력" }
      },
      {
        "id": "terminal-restore-status",
        "description": { "en": "The terminal recovery state", "ko": "터미널 복원 상태" }
      }
    ],
    "programs": [
      {
        "id": "terminal-xterm",
        "title": {
          "en": "Terminal",
          "ko": "터미널"
        },
        "kind": "view",
        "view": "content"
      }
    ],
    "views": [
      {
        "id": "content",
        "title": {
          "en": "Terminal",
          "ko": "터미널"
        },
        "icon": ">_",
        "surfaces": [
          "tab"
        ],
        "status": [
          "connecting",
          "error"
        ]
      }
    ]
  },
  "runtimeDependencies": {
    "sidecars": [
      {
        "id": "soksak-sidecar-pty",
        "version": "0.0.6",
        "url": "https://github.com/soksak-ai/soksak-sidecar-pty/releases/download/v0.0.6/release.json",
        "size": 2996,
        "sha256": "32e05911074b381222cbcac6004c76c93e73c9fe967df57b649af5abb5c69c40"
      },
      {
        "id": "soksak-sidecar-terminal-vt100",
        "version": "0.0.11",
        "url": "https://github.com/soksak-ai/soksak-sidecar-terminal-vt100/releases/download/v0.0.11/release.json",
        "size": 3182,
        "sha256": "542675db960429783f0eeccdab1ce5ff3f1c545eabd5009631dde37920a483f2"
      }
    ]
  }
}
