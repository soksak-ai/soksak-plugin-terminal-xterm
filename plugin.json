{
  "spec": "soksak-spec-plugin@0.0.1",
  "id": "soksak-plugin-terminal-xterm",
  "name": { "en": "Terminal", "ko": "터미널" },
  "version": "0.0.1",
  "description": {
    "en": "A terminal view backed by a real login shell. xterm.js renders; the host's PTY commands run the shell.",
    "ko": "실제 로그인 셸에 붙는 터미널 뷰. 렌더링은 xterm.js, 셸은 호스트의 PTY 명령."
  },
  "entry": "main.js",
  "permissions": ["ui", "commands", "programs", "pty", "terminal"],
  "implements": [{ "id": "soksak-spec-plugin-terminal", "version": "0.0.1" }],
  "consumes": [{ "id": "soksak-spec-plugin-sidebar-file-tree", "range": "^0.0.1" }],
  "contributes": {
    "commands": [
      { "name": "clear", "title": { "en": "Clear terminal", "ko": "터미널 지우기" } },
      { "name": "send", "title": { "en": "Send input", "ko": "입력 보내기" }, "danger": "inject" }
    ],
    "nodes": [
      { "id": "screen", "description": { "en": "The terminal screen", "ko": "터미널 화면" } }
    ],
    "programs": [
      { "id": "terminal-xterm", "title": { "en": "Terminal", "ko": "터미널" }, "kind": "view", "view": "content" }
    ],
    "views": [
      {
        "id": "content",
        "title": { "en": "Terminal", "ko": "터미널" },
        "icon": ">_",
        "placements": ["content"],
        "defaultPlacement": "content",
        "status": ["connecting", "error"],
        "sidebar": {
          "left": [
            {
              "contract": "soksak-spec-plugin-sidebar-file-tree",
              "range": "^0.0.1",
              "view": "tree",
              "instance": "shared"
            }
          ]
        }
      }
    ]
  }
}
