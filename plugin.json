          "ko": "\ud130\ubbf8\ub110 \ubcf5\uc6d0 \uc0c1\ud0dc"
        }
      },
      {
        "name": "split",
        "title": {
          "en": "Split the terminal",
          "ko": "\ud130\ubbf8\ub110 \ubd84\ud560"
        }
      },
      {
        "name": "pane.close",
        "title": {
          "en": "Close a pane",
          "ko": "pane \ub2eb\uae30"
        }
      },
      {
        "name": "pane.focus",
        "title": {
          "en": "Focus a pane",
          "ko": "pane \ud3ec\ucee4\uc2a4"
        }
      },
      {
        "name": "pane.list",
        "title": {
          "en": "List panes",
          "ko": "pane \ubaa9\ub85d"
        }
      },
      {
        "name": "pane.resize",
        "title": {
          "en": "Resize a pane",
          "ko": "pane \ud06c\uae30 \uc870\uc808"
        }
      },
      {
        "name": "pane.equalize",
        "title": {
          "en": "Equalize the panes",
          "ko": "pane \uade0\ub4f1\ud654"
        }
      },
      {
        "name": "pane.maximize",
        "title": {
          "en": "Maximize a pane",
          "ko": "pane \ucd5c\ub300\ud654"
        }
      },
      {
        "name": "pane.broadcast",
        "title": {
          "en": "Broadcast input to every pane",
          "ko": "\ubaa8\ub4e0 pane\uc5d0 \uc785\ub825 \uc804\ub2ec"
        }
      },
      {
        "name": "pane.title",
        "title": {
          "en": "Set a pane title",
          "ko": "pane \uc81c\ubaa9 \uc124\uc815"
        }
      },
      {
        "name": "scroll",
        "title": {
          "en": "Scroll the screen",
          "ko": "\ud654\uba74 \uc2a4\ud06c\ub864"
        }
      },
      {
        "name": "selection",
        "title": {
          "en": "Read or copy the selection",
          "ko": "\uc120\ud0dd \uc77d\uae30\u00b7\ubcf5\uc0ac"
        }
      },
      {
        "name": "input.compose",
        "title": {
          "en": "Compose input text",
          "ko": "\uc785\ub825 \ud14d\uc2a4\ud2b8 \uc870\ud569"
        },
        "danger": "inject"
      },
      {
        "name": "exec",
        "title": {
          "en": "Run a command",
          "ko": "\uba85\ub839 \uc2e4\ud589"
        },
        "danger": "inject"
      },
      {
        "name": "cwd",
        "title": {
          "en": "Working directory",
          "ko": "\uc791\uc5c5 \ub514\ub809\ud130\ub9ac"
        }
      },
      {
        "name": "benchmark.parser",
        "title": {
          "en": "Measure renderer parser",
          "ko": "\ub80c\ub354\ub7ec \ud30c\uc11c \uce21\uc815"
        }
      },
      {
        "name": "renderer.lifecycle",
        "title": {
          "en": "Read renderer lifecycle",
          "ko": "\ub80c\ub354\ub7ec \uc218\uba85 \uc77d\uae30"
        }
      }
    ],
    "nodes": [
      {
        "id": "terminal-root",
        "description": {
          "en": "The terminal root",
          "ko": "\ud130\ubbf8\ub110 \ub8e8\ud2b8"
        }
      },
      {
        "id": "terminal-screen",
        "description": {
          "en": "The terminal screen",
          "ko": "\ud130\ubbf8\ub110 \ud654\uba74"
        }
      },
      {
        "id": "terminal-input",
        "description": {
          "en": "The terminal input",
          "ko": "\ud130\ubbf8\ub110 \uc785\ub825"
        }
      },
      {
        "id": "terminal-restore-status",
        "description": {
          "en": "The terminal recovery state",
          "ko": "\ud130\ubbf8\ub110 \ubcf5\uc6d0 \uc0c1\ud0dc"
        }
      },
      {
        "id": "pane",
        "description": {
          "en": "One terminal pane",
          "ko": "\ud130\ubbf8\ub110 pane \ud558\ub098"
        }
      },
      {
        "id": "gutter",
        "description": {
          "en": "The strip between two panes",
          "ko": "\ub450 pane \uc0ac\uc774\uc758 \ub760"
        }
      }
    ],
    "programs": [
      {
        "id": "terminal-xterm",
        "title": {
          "en": "Terminal",
          "ko": "\ud130\ubbf8\ub110"
        },
        "kind": "view",
        "view": "content"
      }
    ],
    "views": [
      {
        "id": "content",
        "title": {
          "en": "Terminal",
          "ko": "\ud130\ubbf8\ub110"
        },
        "icon": ">_",
        "surfaces": [
          "tab"
        ],
        "status": [
          "connecting",
          "error"
        ]
      }
    ]
  },
  "configuration": [
    {
      "key": "engine",
      "type": "enum",
      "enum": [
        "alacritty",
        "ghostty",
        "kitty",
        "shitty",
        "vt100",
        "wezterm"
      ],
      "enumLabels": [
        {
          "en": "Alacritty",
          "ko": "Alacritty"
        },
        {
          "en": "Ghostty",
          "ko": "Ghostty"
        },
        {
          "en": "kitty",
          "ko": "kitty"
        },
        {
          "en": "shitty",
          "ko": "shitty"
        },
        {
          "en": "VT100",
          "ko": "VT100"
        },
        {
          "en": "WezTerm",
          "ko": "WezTerm"
        }
      ],
      "default": "alacritty",
      "title": {
        "en": "Terminal engine",
        "ko": "\ud130\ubbf8\ub110 \uc5d4\uc9c4"
      },
      "description": {
        "en": "The engine Sidecar a new terminal pane runs on. An open pane keeps its engine.",
        "ko": "\uc0c8 \ud130\ubbf8\ub110 pane\uc774 \uc0ac\uc6a9\ud558\ub294 \uc5d4\uc9c4 Sidecar. \uc774\ubbf8 \uc5f4\ub9b0 pane\uc740 \uc5d4\uc9c4\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4."
      }
    }
  ],
