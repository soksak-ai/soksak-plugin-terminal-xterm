{
  "id": "soksak-plugin-terminal-xterm",
  "name": {
    "en": "Xterm.js Terminal",
    "ko": "Xterm.js 터미널"
  },
  "version": "0.0.57",
  "appVersionRequirement": "0.0.1",
  "description": {
    "en": "A terminal view backed by a real login shell. xterm.js renders; the host's PTY commands run the shell.",
    "ko": "실제 로그인 셸에 붙는 터미널 뷰. 렌더링은 xterm.js, 셸은 호스트의 PTY 명령."
  },
  "entry": "main.js",
  "permissions": [
    "ui",
    "ui:statusbar",
    "commands",
    "programs",
    "sidecar",
    "secrets",
    "terminal",
    "clipboard:read",
    "clipboard:write"
  ],
  "implements": [
    {
      "id": "soksak-spec-plugin-terminal",
      "version": "0.0.17"
    }
  ],
  "contributes": {
    "commands": [
      {
        "name": "status",
        "title": {
          "en": "Terminal status",
          "ko": "터미널 상태"
        }
      },
      {
        "name": "wait",
        "title": {
          "en": "Wait for terminal phase",
          "ko": "터미널 단계 대기"
        }
      },
      {
        "name": "archive",
        "title": {
          "en": "Archive terminal state",
          "ko": "터미널 상태 보관"
        }
      },
      {
        "name": "send",
        "title": {
          "en": "Send input",
          "ko": "입력 보내기"
        },
        "danger": "inject"
      },
      {
        "name": "read",
        "title": {
          "en": "Read the screen",
          "ko": "화면 읽기"
        }
      },
      {
        "name": "clear",
        "title": {
          "en": "Clear terminal",
          "ko": "터미널 지우기"
        }
      },
      {
        "name": "focus",
        "title": {
          "en": "Focus terminal",
          "ko": "터미널 포커스"
        }
      },
      {
        "name": "recovery-status",
        "title": {
          "en": "Terminal recovery status",
          "ko": "터미널 복원 상태"
        }
      },
      {
        "name": "split",
        "title": {
          "en": "Split the terminal",
          "ko": "터미널 분할"
        }
      },
      {
        "name": "pane.close",
        "title": {
          "en": "Close a pane",
          "ko": "pane 닫기"
        }
      },
      {
        "name": "pane.focus",
        "title": {
          "en": "Focus a pane",
          "ko": "pane 포커스"
        }
      },
      {
        "name": "pane.list",
        "title": {
          "en": "List panes",
          "ko": "pane 목록"
        }
      },
      {
        "name": "pane.resize",
        "title": {
          "en": "Resize a pane",
          "ko": "pane 크기 조절"
        }
      },
      {
        "name": "pane.equalize",
        "title": {
          "en": "Equalize the panes",
          "ko": "pane 균등화"
        }
      },
      {
        "name": "pane.maximize",
        "title": {
          "en": "Maximize a pane",
          "ko": "pane 최대화"
        }
      },
      {
        "name": "pane.broadcast",
        "title": {
          "en": "Broadcast input to every pane",
          "ko": "모든 pane에 입력 전달"
        }
      },
      {
        "name": "pane.title",
        "title": {
          "en": "Set a pane title",
          "ko": "pane 제목 설정"
        }
      },
      {
        "name": "scroll",
        "title": {
          "en": "Scroll the screen",
          "ko": "화면 스크롤"
        }
      },
      {
        "name": "selection",
        "title": {
          "en": "Read or copy the selection",
          "ko": "선택 읽기·복사"
        }
      },
      {
        "name": "copy",
        "title": {
          "en": "Copy the selection",
          "ko": "선택 복사"
        }
      },
      {
        "name": "paste",
        "title": {
          "en": "Paste terminal input",
          "ko": "터미널 입력 붙여넣기"
        },
        "danger": "inject"
      },
      {
        "name": "drop",
        "title": {
          "en": "Drop files or images",
          "ko": "파일·이미지 드롭"
        },
        "danger": "inject"
      },
      {
        "name": "input.compose",
        "title": {
          "en": "Compose input text",
          "ko": "입력 텍스트 조합"
        },
        "danger": "inject"
      },
      {
        "name": "exec",
        "title": {
          "en": "Run a command",
          "ko": "명령 실행"
        },
        "danger": "inject"
      },
      {
        "name": "cwd",
        "title": {
          "en": "Working directory",
          "ko": "작업 디렉터리"
        }
      },
      {
        "name": "benchmark.parser",
        "title": {
          "en": "Measure renderer parser",
          "ko": "렌더러 파서 측정"
        }
      },
      {
        "name": "renderer.lifecycle",
        "title": {
          "en": "Read renderer lifecycle",
          "ko": "렌더러 수명 읽기"
        }
      }
    ],
    "nodes": [
      {
        "id": "terminal-root",
        "description": {
          "en": "The terminal root",
          "ko": "터미널 루트"
        }
      },
      {
        "id": "terminal-screen",
        "description": {
          "en": "The terminal screen",
          "ko": "터미널 화면"
        }
      },
      {
        "id": "terminal-input",
        "description": {
          "en": "The terminal input",
          "ko": "터미널 입력"
        }
      },
      {
        "id": "terminal-drop-target",
        "description": {
          "en": "The terminal file and image drop target",
          "ko": "터미널 파일·이미지 드롭 대상"
        }
      },
      {
        "id": "terminal-restore-status",
        "description": {
          "en": "The terminal recovery state",
          "ko": "터미널 복원 상태"
        }
      },
      {
        "id": "pane",
        "description": {
          "en": "One terminal pane",
          "ko": "터미널 pane 하나"
        }
      },
      {
        "id": "gutter",
        "description": {
          "en": "The strip between two panes",
          "ko": "두 pane 사이의 띠"
        }
      }
    ],
    "programs": [
      {
        "id": "terminal-xterm",
        "title": {
          "en": "Terminal",
          "ko": "터미널"
        },
        "kind": "view",
        "view": "content"
      }
    ],
    "views": [
      {
        "id": "content",
        "title": {
          "en": "Terminal",
          "ko": "터미널"
        },
        "icon": ">_",
        "surfaces": [
          "tab"
        ],
        "status": [
          "connecting",
          "error"
        ]
      }
    ]
  },
  "configuration": [
    {
      "key": "engine",
      "type": "enum",
      "enum": [
        "alacritty",
        "ghostty",
        "kitty",
        "shitty",
        "vt100",
        "wezterm"
      ],
      "enumLabels": [
        {
          "en": "Alacritty",
          "ko": "Alacritty"
        },
        {
          "en": "Ghostty",
          "ko": "Ghostty"
        },
        {
          "en": "kitty",
          "ko": "kitty"
        },
        {
          "en": "shitty",
          "ko": "shitty"
        },
        {
          "en": "VT100",
          "ko": "VT100"
        },
        {
          "en": "WezTerm",
          "ko": "WezTerm"
        }
      ],
      "default": "alacritty",
      "title": {
        "en": "Terminal engine",
        "ko": "터미널 엔진"
      },
      "description": {
        "en": "The engine Sidecar a new terminal pane runs on. An open pane keeps its engine.",
        "ko": "새 터미널 pane이 사용하는 엔진 Sidecar. 이미 열린 pane은 엔진을 유지합니다."
      }
    }
  ],
  "runtimeDependencies": {
    "sidecars": [
      {
        "id": "soksak-sidecar-pty",
        "version": "0.0.17"
      },
      {
        "id": "soksak-sidecar-terminal-alacritty",
        "version": "0.0.37"
      },
      {
        "id": "soksak-sidecar-terminal-ghostty",
        "version": "0.0.33"
      },
      {
        "id": "soksak-sidecar-terminal-kitty",
        "version": "0.0.29"
      },
      {
        "id": "soksak-sidecar-terminal-shitty",
        "version": "0.0.28"
      },
      {
        "id": "soksak-sidecar-terminal-vt100",
        "version": "0.0.32"
      },
      {
        "id": "soksak-sidecar-terminal-wezterm",
        "version": "0.0.32"
      }
    ]
  }
}
