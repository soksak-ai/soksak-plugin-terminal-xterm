{
  "spec": "soksak-spec-plugin@0.0.1",
  "id": "soksak-plugin-terminal-xterm",
  "name": {
    "en": "Terminal",
    "ko": "터미널"
  },
  "version": "0.0.1",
  "description": {
    "en": "A terminal view backed by a real login shell. xterm.js renders; the host's PTY commands run the shell.",
    "ko": "실제 로그인 셸에 붙는 터미널 뷰. 렌더링은 xterm.js, 셸은 호스트의 PTY 명령."
  },
  "entry": "main.js",
  "permissions": [
    "ui",
    "ui:statusbar",
    "commands",
    "programs",
    "pty",
    "terminal"
  ],
  "contributes": {
    "commands": [
      {
        "name": "clear",
        "title": {
          "en": "Clear terminal",
          "ko": "터미널 지우기"
        }
      },
      {
        "name": "send",
        "title": {
          "en": "Send input",
          "ko": "입력 보내기"
        },
        "danger": "inject"
      },
      {
        "name": "read",
        "title": {
          "en": "Read the screen",
          "ko": "화면 읽기"
        }
      },
      {
        "name": "exec",
        "title": {
          "en": "Run a command",
          "ko": "명령 실행"
        },
        "danger": "inject"
      },
      {
        "name": "cwd",
        "title": {
          "en": "Working directory",
          "ko": "작업 디렉터리"
        }
      },
      {
        "name": "benchmark.render",
        "title": {
          "en": "Measure renderer parser",
          "ko": "렌더러 파서 측정"
        }
      }
    ],
    "nodes": [
      {
        "id": "screen",
        "description": {
          "en": "The terminal screen",
          "ko": "터미널 화면"
        }
      }
    ],
    "programs": [
      {
        "id": "terminal-xterm",
        "title": {
          "en": "Terminal",
          "ko": "터미널"
        },
        "kind": "view",
        "view": "content"
      }
    ],
    "views": [
      {
        "id": "content",
        "title": {
          "en": "Terminal",
          "ko": "터미널"
        },
        "icon": ">_",
        "surfaces": [
          "tab"
        ],
        "status": [
          "connecting",
          "error"
        ]
      }
    ]
  }
}
